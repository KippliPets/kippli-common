{
  "name": "@kippli/common",
  "version": "0.1.0",
  "description": "Shared contracts, NestJS building blocks, and the internal service-to-service HTTP client for the Kippli apps (one, mykippli, halo).",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./nest": {
      "types": "./dist/nest/index.d.ts",
      "default": "./dist/nest/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "@nestjs/throttler": ">=6",
    "class-transformer": ">=0.5",
    "class-validator": ">=0.14",
    "rxjs": ">=7"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": { "optional": true },
    "@nestjs/throttler": { "optional": true },
    "class-transformer": { "optional": true },
    "class-validator": { "optional": true },
    "rxjs": { "optional": true }
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@types/node": "^22.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^5.6.3"
  }
}
